    // },
    // How a card shows its run status on the board: labels, deadline and pause.
    // A card's run status on the board. Default: the values of the fields below.
    // "status": {
      // The names of the three run status labels. Default: the values of the fields below.
      // "labels": {
        // Label of a card a run is currently working on. Default: `run:running`.
        // "running": "run:running",
        // Label of a card aborted for technical reasons: repeating is enough. Default: `run:aborted`.
        // "aborted": "run:aborted",
        // Label of a waiting card; what it is waiting for is stated verbatim in the run status. Default: `run:waiting`.
        // "waiting": "run:waiting"
      // },
      // Detection period in minutes after a run's last sign of life. Default: `10`.
      // "deadlineMin": 10,
      // Pause in minutes before the one automatic attempt after an environment error of the live run. Default: `5`.
      // "pauseMin": 5
    // },
    // The model of every session of the automatic run that has no model of its own. Default: the model built into the runner.
    // "model": "",
    // The model names the runner may start, strongest first. Default: empty, every session starts with the model of the run.
    // "models": [
    //   "claude-opus-5",
    //   "claude-sonnet-5"
    // ],
    // Which model the automatic run starts for each difficulty tier of a package.
    // Model or command per difficulty level of a work package, ordered hard/medium/easy. Default: no tier, every package runs with the model of the run.
    // "tiers": {
      // Model or command for a hard task. No default.
      // `night.tiers.hard.model` — Model ID for this level. No default.
      // `night.tiers.hard.effort` — Thinking effort for this level, passed to the Claude CLI as --effort. Valid: `low`, `medium`, `high`, `xhigh`, `max`. Default: the Claude CLI's own setting.
      // `night.tiers.hard.command` — Command line of a third-party program for this tier. No default.
      // `night.tiers.hard.name` — The program's self-description next to command. No default.
      // "hard": {},
      // Model or command for a medium task. No default.
      // `night.tiers.medium.model` — Model ID for this level. No default.
      // `night.tiers.medium.effort` — Thinking effort for this level, passed to the Claude CLI as --effort. Valid: `low`, `medium`, `high`, `xhigh`, `max`. Default: the Claude CLI's own setting.
      // `night.tiers.medium.command` — Command line of a third-party program for this tier. No default.
      // `night.tiers.medium.name` — The program's self-description next to command. No default.
