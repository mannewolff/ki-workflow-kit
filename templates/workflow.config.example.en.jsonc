  // The daily check run: its label, its time and its cost.
  // The daily check run. Default: the values of the fields below.
  // "checkRun": {
    // The marker on the functional requirement that the run has reviewed. Default: `kit:check`.
    // "label": "kit:check",
    // Time budget of the reviewer session per card in minutes. Default: `25`.
    // "checkMin": 25,
    // Cost budget per run in US dollars, checked after every session. Default: `25`.
    // "costUsd": 25
  // },

  // The thresholds from which the workload evaluation reports a finding.
  // Scope and thresholds of the workload evaluation. Default: the values of the fields below.
  // "workload": {
    // The maximum number of the most recent completed result records the evaluation includes, most recent first. Default: `10`.
