      // Share of the total running time that pure tool work may take before a finding appears. Values: 0 to 1. Default: `0.5`.
      // "toolShare": 0.5,
      // Highest share of the writing costs in the total costs without a finding. Values: 0 to 1. Default: `0.75`.
      // "writeCostShare": 0.75
    // }
