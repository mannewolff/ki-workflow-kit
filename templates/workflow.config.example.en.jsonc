      // `night.tiers.easy.effort` — Thinking effort for this level, passed to the Claude CLI as --effort. Valid: `low`, `medium`, `high`, `xhigh`, `max`. Default: the Claude CLI's own setting.
      // `night.tiers.easy.command` — Command line of a third-party program for this tier. No default.
      // `night.tiers.easy.name` — The program's self-description next to command. No default.
      // "easy": {}
    // },
    // Replaces the built-in rule by which /issues and /task determine the level of a work package. Default: the kit's rule.
    // "tierRule": "",
    // Number of identically failed runs of the same check after which an unattended session is stopped. Values: from 2. Default: `3`.
    // "stuckAfter": 3,
    // Target for the duration of an implementation in minutes. Default: `10`.
    // "goalImplementationMin": 10,
    // Packages implemented simultaneously in the implementation run; 1 switches this off. Values: from 1. Default: `1`.
    // "concurrentPackages": 1,
    // Overall time limit of the implementation run in minutes. Values: from 1. No default.
    // "implementationNightMin": 0,
    // Cost limit per implementation, in US dollars. Default: `150`.
    // "implementationCostUsd": 150,
    // Period in days after which the runner deletes its logs. Values: from 1. Default: `14`.
    // "logRetentionDays": 14
