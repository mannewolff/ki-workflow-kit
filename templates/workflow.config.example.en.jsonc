// SPDX-License-Identifier: MIT
// Example file for .claude/workflow.config.json: every setting the kit knows, with the sentence from the settings page.
// The kit never reads this file, and every update renews it — changes made here are lost.
// The settings needed at setup are active with example values; all others are commented out with their default.
// To take one over: copy the line into .claude/workflow.config.json, remove the leading // and adjust the value.
{
  // === Needed at setup ===

  // Language of the kit in this project: de (German) or en (English). Valid: `de`, `en`. Default: `de`. Switches the kit's texts, board names and comments to English; set `en` when the team works in English.
  "language": "en",

  // Where the code lives (push, pull requests). Valid: `github`, `gitlab`, `local`. Default: `github`. Decides where pushes go; set it when the code is not on GitHub.
  "codeHost": "github",

  // Where the issues are managed. Valid: `github`, `gitlab`, `local`, `toolbox`. Default: `github`. Decides where the board lives; set it when the issues are not on GitHub.
  "issueTracker": "github",

  // The project's check commands (build, tests). Default: `[]`. Decides what is checked before each commit and before `push main`; enter the project's build and test commands at setup.
  // `buildChecks[]` — A check command, as a command string or as an object with `cmd` and the fields below. No default.
  // `buildChecks[].cmd` — The command line as it would appear in the string form. No default.
  // `buildChecks[].areas` — Area names from `checkAreas`; the check runs when one of them is touched. No default.
  // `buildChecks[].always` — true = always runs, by decision, regardless of the touched areas. No default.
  // `buildChecks[].stage` — When the check is due: "paket" at the completion of a work package, "push" before publishing, "merge" before the release. Valid: `paket`, `push`, `merge`. Default: `paket`.
  // `buildChecks[].notAtCompletion` — Why the check may be skipped at the completion of a single package. Valid: `zusammenspiel`, `volleTestmenge`. Default: not set, the check also runs at completion.
  // `buildChecks[].completionAreas` — Areas whose touch makes the check run at completion too. Default: not set, the check is skipped at completion.
  // `buildChecks[].quality` — Marks this check as a quality measurement whose value below the threshold stops publishing. No default.
  // `buildChecks[].quality.pattern` — Regular expression with exactly one group; it picks the measured percentage from the command's output. No default.
  // `buildChecks[].quality.marker` — The percentage from which the measurement suffices. Values: 0 to 100. No default.
  // `buildChecks[].concurrent` — Whether this check may run alongside others in "checks.mjs run". Default: `false`.
  // `buildChecks[].upfront` — Whether this check runs in "checks.mjs run" before all others. Default: `false`.
  // `buildChecks[].deferOnHotfix` — A hotfix defers the check to the next regular path. Default: `false`.
  // `buildChecks[].weight` — The weight of the check when `checks.mjs` distributes it across parts with `--part`. Values: from 1. Default: for `node --test` the number of its test files, otherwise 1.
  // `buildChecks[].description` — One sentence on what the check secures, at most 200 characters; repair card and app show it instead of the command. Default: none, the check is named after its command.
  // `buildChecks[].kind` — With `hinweis` the check only reports and never stops. Valid: `hinweis`. Default: an ordinary check whose red result stops the run.
  "buildChecks": [
    "mvn verify",
    {
      "cmd": "npm --prefix frontend run build",
      "areas": [
        "frontend"
      ]
    }
  ],

  // Threshold for the result of "mutationCommand" (optional). No default. Gives the mutation test a threshold below which `strict` stops publishing; set it when the project has `mutationCommand`.
  // "mutationQuality": {
    // Regular expression with exactly one group; it captures the measured percentage from the output of the mutation test, like "pattern" in the "quality" block of a buildChecks entry. No default.
    // "pattern": "",
    // The percentage from which the mutation test is sufficient. Values: 0 to 100. No default.
    // "marker": 0
  // },

  // How strictly the kit checks this project: "light" for ideas, prototypes and experiments, "normal" for an ordinary project, "strict" for projects with high security demands. Valid: `leicht`, `normal`, `streng`. Default: `normal`. Sets how much runs before publishing; `light` for prototypes, `strict` for projects with high security demands.
  // "strictness": "normal",

  // Individual deviations from what the strictness sets (optional). No default. Deviates from the strictness one switch at a time; set it when a default of the strictness does not fit this project.
  // "strictnessOverrides": {
    // Scope of the check run before publishing: "areas" only the areas touched since the last publishing, "full" the whole state. Valid: `bereiche`, `voll`. No default.
    // "pushScope": "",
    // What happens with the mutation test before publishing: "off" it does not run, "report" it runs and reports, "block" a value below the threshold from "mutationQuality" stops. Valid: `aus`, `bericht`, `halt`. No default.
    // "mutation": "",
    // Whether the quality measurement is mandatory: "as-configured" it runs as a "quality" block sets it up, "required" a missing measurement or threshold is named as a gap. Valid: `wie-eingerichtet`, `pflicht`. No default.
    // "quality": "",
    // When the security check runs: "before-push" before every publishing, "before-delivery" only before delivery. Valid: `vor-push`, `vor-auslieferung`. No default.
    // "security": "",
    // Number of reviewers for requirement and plan, independent of the strictness. No default.
    // "reviewers": {
      // Number of reviewers for a requirement. Values: from 1. No default.
      // "requirement": 0,
      // Number of reviewers for a plan. Values: from 1. No default.
      // "plan": 0
    // },
    // Whether the full check run, the mutation test and the security check are caught up before delivery. No default.
    // "deliveryCatchUp": false
  // },

  // Branch for local commits and push (step 7). Default: `main`. The branch for local commits and `push main`; set it only when it is not called `main`.
  "mainBranch": "main",

  // Target branch for the PR in step 8 (merge production). Default: `production`. The branch `merge production` opens the pull request against; set it only when it is not called `production`.
  "productionBranch": "production",

  // `false` records the waiver of the commit gate. Default: `true`. Written by the installer when the gate is declined.
  // "commitGate": true,

  // `false`: no live instance. Default: `true`. Then rollback and the stop without a rollback point are dropped.
  // "runsInstance": true,

  // Settings for the local issue tracker (issueTracker: 'local'). Default: the values of the fields below. The folder of the issues; set it only with `issueTracker` `local` and a folder other than `issues`.
  "local": {
    // Directory of the issue Markdown files, relative to the project root. Default: `issues`.
    "issuesDir": "issues"
  },

  // GitHub-specific settings. No default. The GitHub project whose columns are the board; needed at setup with a board on GitHub, the installer enters it.
  "github": {
    // Number of the GitHub Project board (gh project list). Values: from 1. No default.
    "projectNumber": 1
  },

  // Settings for the Toolbox issue tracker (issueTracker: 'toolbox'). No default. Access to the author's Toolbox tracker; set it only with `issueTracker` `toolbox`.
  // "toolbox": {
    // Base URL of the Toolbox instance. No default.
    // "host": "",
    // Path (relative to the project directory) to a file holding the project- or board-bound token. No default.
    // "tokenFile": ""
  // },

  // Issue review across several models. No default. Decides which models review requirement, plan and packages; set it at setup, because without reviewers the chain stops before it starts.
  "issueReview": {
    // If true, the runner moves Ready issues without a review marker back to the backlog with a comment. Default: `false`.
    "requiredBeforeReady": false,
    // The reviewers in the order in which they are taken; never the author. No default.
    // `issueReview.reviewers[].name` — Short name, compared with the issue's author model. No default.
    // `issueReview.reviewers[].kind` — 'claude' runs as a subagent via the Agent tool, 'command' as any foreign CLI (prompt via stdin). Valid: `claude`, `command`. No default.
    // `issueReview.reviewers[].model` — Only for kind 'claude': model identifier. No default.
    // `issueReview.reviewers[].command` — Only for kind 'command': command line, e.g. 'codex exec --model gpt-5'. No default.
    // `issueReview.reviewers[].readLimit` — Only for kind 'command': the read-only switch of the third-party tool. No default.
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5"
      }
    ],
    // Explicit mapping author -> reviewer. Default: no assignment, the order in `reviewers` applies.
    "pairs": {
      "opus": [
        "sonnet",
        "fable"
      ],
      "sonnet": [
        "opus",
        "fable"
      ],
      "fable": [
        "opus",
        "sonnet"
      ],
      "haiku": [
        "sonnet",
        "opus"
      ]
    }
  }

  // === Worth setting ===

  // Named areas of the project. No default. Maps paths to named areas so that a check runs only when its area is touched; set it as soon as the full check run takes too long.
  // "checkAreas": {
  //   "frontend": [
  //     "frontend/**"
  //   ]
  // },

  // Files that no check reads. Default: `[]`. Takes them out of the full check run; set it when, for example, a plain text change triggers every check.
  // `noCheck[].pattern` — Path pattern as in checkAreas: "*" within a segment, "**" across segment boundaries, "/" as separator. No default.
  // `noCheck[].reason` — Why no check reads the content of this file. No default.
  // "noCheck": [],

  // Areas with a measured coupling. Default: `[]`. Records an intended coupling with a reason; set it when the evaluation reports such an area.
  // `coupledAreas[].area` — Name of the area as it appears in checkAreas. No default.
  // `coupledAreas[].reason` — Which measured coupling forces the area into almost every check command. No default.
  // "coupledAreas": [],

  // Where a component's own tests live. Default: the kit's locations for TypeScript and Java. With it, a plan gets hints about affected tests; set it when the layout does not follow the TypeScript or Java pattern.
  // `testLocations[].source` — Pattern of the source file, for example src/{pfad}/{name}.ts. No default.
  // `testLocations[].test` — Pattern of its own test, with the same placeholders and * within a segment, for example src/{pfad}/{name}*.test.ts. No default.
  // `testLocations[].defaults` — Inserts the kit's defaults at this position. Value: `true`. No default.
  // "testLocations": [],

  // Command for mutation tests (optional). Default: empty. Runs mutation tests before each `push main` that only report; set it when the project has a tool such as PIT or Stryker.
  // "mutationCommand": "",

  // Further commands or command prefixes that start a quality measurement (optional). Default: `[]`. Keeps further quality measurements out of the packages' acceptance criteria; set it when the project has an expensive measurement that is not a check.
  // "qualityCommands": [],

  // Command that fixes formatting violations. Default: empty. Checks once more afterwards instead of ending the run red; set it when the project has a formatter.
  // "formatFixCommand": "",

  // Command that installs the dependencies. Default: empty. Runs in a fresh worktree; set it when the project uses worktrees and has to install packages, for example with `npm ci`.
  // "installCommand": "",

  // Where the full check run before 'push main' takes place. Valid: `lokal`. Default: `lokal`. Moves the run to the build service; set it when it takes too long locally.
  // `pushCheck.location` — The place of the full run: the project's build service. Valid: `buildDienst`. No default.
  // `pushCheck.branch` — The check branch that /push-main pushes before the push and deletes afterwards. No default.
  // `pushCheck.machine` — The identifier of this computer that its own check branch carries after branch and a hyphen, made of lowercase letters, digits and hyphens. Default: the identifier the kit determines for the computer.
  // "pushCheck": "local",

  // Commands that put version and changelog into the checked state. No default. Advances version and changelog with every checked card; set it when both should belong to the checked state.
  // "release": {
    // The command lines in order, in the kit repo `node tools/version.mjs --patch`, `node tools/changelog.mjs --marke v<version>` and `node tools/sync-blobs.mjs`. Default: `[]`.
    // "commands": []
  // },

  // Scope of the review material. Valid: `diff`, `full`. Default: `diff`. Diff since the last push or the whole source; set `full` for a review of the whole project.
  // "reviewScope": "diff",

  // The Claude model of the code review. Default: `claude-opus-4-8`. The Claude model that reviews the code; set it when a model other than the default is to review.
  // "reviewModel": "claude-opus-4-8",

  // A third-party CLI as code reviewer, counterpart of reviewModel. Default: not set, `reviewModel` reviews. Lets a third-party CLI review; set it when a model from another provider is to review.
  // "reviewCommand": "",

  // Staffing and perspective of the three review levels: the functional concern, the plan to get there, the single work package. Default: per tier the roles of the role catalogue, one reviewer per role, only if the whole block is missing; an incomplete block aborts the config check. Decides the reviewers per stage; set it when a stage is to review more thoroughly or more sparingly.
  // "reviewStages": {
    // Review of the functional concern ([Requirement] issue) before a plan is made from it. No default.
    // "requirement": {
      // How many reviewers review this level. Values: from 1. Default: `2`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "reviewer": 2,
      // One role name per reviewer, in the order of assignment. Default: `form-beobachtbarkeit`, `abgrenzung`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "roles": [
      //   "form-beobachtbarkeit",
      //   "abgrenzung"
      // ]
    // },
    // Review of the plan document ([Plan] issue) before it is split into work packages. No default.
    // "plan": {
      // How many reviewers review this level. Values: from 1. Default: `2`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "reviewer": 2,
      // One role name per reviewer, in the order of assignment. Default: `architektur-bestand`, `schnitt-abhaengigkeiten`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "roles": [
      //   "architektur-bestand",
      //   "schnitt-abhaengigkeiten"
      // ]
    // },
    // Review of the single work package before the GO. No default.
    // "issue": {
      // How many reviewers review this level. Values: from 1. Default: `1`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "reviewer": 1,
      // One role name per reviewer, in the order of assignment. Default: `pruefbarkeit`, only if the whole `reviewStages` block is missing; a block that is present needs the field.
      // "roles": [
      //   "pruefbarkeit"
      // ]
    // }
  // },

  // Earlier requirements on the same subject. Default: `true`. Lets requirement and plan name them; switch it off with `false` only when the board's history does not matter.
  // "history": true,

  // The partner repos of this project. Default: `[]`, no partner repo. Requires a contracts section in every plan; add an entry as soon as another repo reads or writes names or formats of this project.
  // `contractRepos[].name` — Short name of the partner repo, for example kanban-kit: lowercase letters and digits, words separated by single hyphens. No default.
  // `contractRepos[].url` — Address from which the partner repo can be cloned, for example https://github.com/mannewolff/kanban-kit.git. No default.
  // `contractRepos[].branch` — Main branch of the partner repo: a contract is checked against the built state on this branch. Default: `main`.
  // "contractRepos": [],

  // Desktop app. No default. Set it for customers of the app.
  // "app": {
    // Customer brand. No default.
    // "brand": {
      // App name. No default.
      // "name": "",
      // Logo, PNG or SVG. No default.
      // "logo": "",
      // Accent colour, #rrggbb. No default.
      // "accent": "",
      // Accent colour in dark mode. No default.
      // "accentDark": ""
