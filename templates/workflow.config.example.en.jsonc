    // Control center address, path /boards/:boardId/leitstand. No default.
    // "controlCenterUrl": "",
    // Limit for “Do it now”. No default.
    // "quickFix": {
      // Time limit, minutes per start. Default: `30`.
      // "timeMin": 30,
      // Cost limit, US dollars per start. Default: `10`.
      // "costUsd": 10
