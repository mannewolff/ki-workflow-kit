  // === Managed by the kit ===

  // _Set by the installer._ Version identifier x.y.z. Default: `1.4.0`.
  // "version": "1.4.0",

  // _Deprecated._ Is carried over to `codeHost` and `issueTracker` on loading; do not set it in a new config. Valid: `github`, `gitlab`, `local`. No default.
  // "provider": "",

  // _Set by the installer._ Cut-off of the scenario requirement, as a card number. Values: from 1. Default: not set, the obligation applies to no card on the board; the installer sets the field on update.
  // "scenariosFrom": 0,

  // === Fine-tuning ===

  // Exceptions for the check-area comparison; set it when areas suggest names a path as a candidate for this list.
  // Paths that test files only create as scaffolding — mentioning them in a test file proves no coupling. Default: `[]`.
  // `scaffoldOnly[].pattern` — Path pattern as in checkAreas: "*" within a segment, "**" across segment boundaries, "/" as separator. No default.
  // `scaffoldOnly[].reason` — Why no test file checks this path but at most creates it as scaffolding. No default.
  // "scaffoldOnly": [],

  // Target time of a hotfix in minutes. Values: from 1. Default: `20`.
  // "hotfixMinutes": 20,

  // The read-only switch of the third-party CLI from reviewCommand. Default: the built-in switch for codex.
  // "reviewReadLimit": "",

  // The phrases the human uses to release their stop points.
  // Trigger phrases for the human stop points. Default: the values of the fields below.
  // "triggers": {
    // Phrase for the GO to implement. Default: `GO`.
    // "go": "GO",
    // Phrase for the push to mainBranch (step 7). Default: `push main`.
    // "push": "push main",
    // Phrase for the PR to productionBranch (step 8). Default: `merge production`.
    // "merge": "merge production",
    // Phrase for the hotfix. Default: `hotfix production`.
    // "hotfix": "hotfix production",
    // Phrase for the rollback. Default: `rollback production`.
    // "rollback": "rollback production"
  // },

  // The names of the columns and labels, when the board calls them differently from the kit.
  // Mapping of the internal statuses to board column or label names. Default: the values of the fields below.
  // "columns": {
    // Name of the column or label for Backlog; on GitLab, `Open` turns it into the open state without a label. Default: `Backlog`.
    // "backlog": "Backlog",
    // Name of the column or label for Ready — released, the human's GO. Default: `Ready`.
    // "ready": "Ready",
    // Name of the column or label for In progress — the work package currently being worked on. Default: `In progress`.
    // "in_progress": "In progress",
    // Name of the column or label for In review — done locally, not yet pushed. Default: `In review`.
    // "in_review": "In review",
    // Name of the Done column on GitHub and locally; GitLab always uses the closed state. Default: `Done`.
    // "done": "Done"
  // },

  // Unattended mode: which models may run, how long an implementation should take and when a run counts as stuck.
  // Unattended mode. No default.
  // "night": {
    // The budgets of the chain: time, cost and correction rounds per step before the chain stops.
    // Budgets and markers of the chain (night.mjs --chain). No default.
    // "chain": {
      // The marker on the functional requirement or the plan document that starts the chain. Default: `kit:night`.
      // "label": "kit:night",
      // The marker that flags the marked card for the chain's implementation stage (variant B). Default: `kit:carry-through`.
      // "variantBLabel": "kit:carry-through",
      // Time budget of the plan stage in minutes, including correction rounds. Default: `20`.
      // "planMin": 20,
      // Time budget of the packages stage in minutes, including correction rounds. Default: `15`.
      // "packagesMin": 15,
      // Time budget of the reviewer session on the plan in minutes. Default: `15`.
      // "reviewMin": 15,
      // Time budget of the coverage session in minutes. Default: `10`.
      // "coverageMin": 10,
      // Time budget of the implementation stage (variant B) in minutes, across all implementation sessions of the chain. Default: `120`.
      // "implementationMin": 120,
      // Time limit of the push preparation in minutes, waiting and check run included. Default: `120`.
      // "preparationMin": 120,
      // Cost budget per chain in US dollars, summed over all sessions of the chain; checked after every session. Default: `50`.
      // "costUsd": 50,
      // Cost budget per chain in US dollars for the implementation stage (variant B). Default: `150`.
      // "costUsdB": 150,
      // Maximum number of correction sessions per document after a red form check. Values: from 1. Default: `2`.
      // "correctionRounds": 2,
      // Which transitions of the chain may follow automatically. Default: every transition follows, implementation only for a card with the variant B label.
      // "transitions": {
        // After the plan, the review of the plan follows automatically. Default: `true`.
        // "planReview": true,
        // After the review of the plan, the work packages follow automatically. Default: `true`.
        // "reviewPackages": true,
        // After the work packages, the coverage against the functional requirement or against the plan follows automatically. Default: `true`.
        // "packagesCoverage": true,
        // After the coverage, the implementation follows automatically. Default: only a card with the variant B label is implemented.
        // "coverageImplementation": false,
        // Whether the push preparation follows the implementation. Default: `true`.
        // "implementationPreparation": true
